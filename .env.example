# Telegram Bot Token (@BotFather dan olinadi)
BOT_TOKEN=your_telegram_bot_token_here

# OpenAI API sozlamalari
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Ixtiyoriy: OpenAI-mos boshqa provayderlar (masalan, OpenRouter, DeepSeek) uchun Base URL
# Standart OpenAI uchun bo'sh qoldiring
OPENAI_BASE_URL=

# Suhbat konteksti cheklovlari
MAX_CONTEXT_MESSAGES=20
MAX_CONTEXT_CHARS=12000

# Ma'lumotlar bazasi fayli manzili
DB_PATH=data/bot.db
